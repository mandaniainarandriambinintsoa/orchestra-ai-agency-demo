# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
ENABLE_N8N_QUALIFICATION=false
ALLOW_EXTERNAL_SIDE_EFFECTS=false

# Supabase — use the new publishable and secret keys from the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# n8n — server-side only. Use paths, not full webhook URLs, for allow-listed calls.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_PROSPECT_SEARCH_WEBHOOK_PATH=

# Required before enabling a paid/live server action without user authentication.
APP_ACTION_TOKEN=

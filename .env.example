# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
ENABLE_N8N_QUALIFICATION=true
ALLOW_EXTERNAL_SIDE_EFFECTS=true

# Supabase — use the new publishable and secret keys from the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# n8n — server-side only. Use paths, not full webhook URLs, for allow-listed calls.
N8N_BASE_URL=
N8N_WEBHOOK_API_KEY=
N8N_PROSPECT_QUALIFY_WEBHOOK_PATH=/webhook/orchestra-qualify-prospect
N8N_CHAT_WEBHOOK_PATH=/webhook/orchestra-chat-agent
N8N_PERSONALIZE_WEBHOOK_PATH=/webhook/personalize-message
CRON_SECRET=

# Required before enabling a paid/live server action without user authentication.
APP_ACTION_TOKEN=
